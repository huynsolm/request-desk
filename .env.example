API_PORT=3001
# DB_PATH=data/app.db
# 분석 제공자: mock(모의 분석, 개발용, 기본) / ai(Anthropic Claude API) / openai(OpenAI ChatGPT API)
# ANALYSIS_PROVIDER=mock
# ANALYSIS_TIMEOUT_MS=30000
# MOCK_ANALYSIS_DELAY_MS=1500

# ── 실제 AI(3단계) ── 아래를 .env 에 "직접" 채우세요. 키를 채팅·커밋에 올리지 마세요(.env 는 git 제외).
# ANALYSIS_PROVIDER=ai
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5     # 더 싸게: claude-sonnet-5-5 / claude-haiku-5-5
# ── 실제 AI: ChatGPT(OpenAI) 를 쓸 때 ──
# ANALYSIS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini     # 거부되면 계정에서 쓸 수 있는 모델 이름으로 바꾸세요
# 호출 횟수 상한(공통)
# AI_DAILY_LIMIT=20
# AI_MONTHLY_LIMIT=300

# 개발 웹(Vite)이 5173 이 아닌 포트일 때만: 허용할 출처를 쉼표로 구분
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
