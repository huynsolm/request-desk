# 1단계는 비밀키가 필요 없습니다. (3단계 실제 AI 연결 때 서버 전용 키를 여기에 추가)
API_PORT=3001
# DB_PATH=data/app.db
# 분석 제공자: 지금은 mock(모의 분석, 개발용)만 있습니다. 실제 AI 는 3단계에서 추가됩니다.
# ANALYSIS_PROVIDER=mock
# ANALYSIS_TIMEOUT_MS=30000
# MOCK_ANALYSIS_DELAY_MS=1500
# 개발 웹(Vite)이 5173 이 아닌 포트일 때만: 허용할 출처를 쉼표로 구분
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
